            <name>Time difference Zabbix server VS Zabbix proxy 5.0</name>
            <groups>
                <group>
                    <name>debug</name>
                </group>
            </groups>
            <applications>
                <application>
                    <name>time</name>
                </application>
                <application>
                    <name>timeDiffProxy</name>
                </application>
            </applications>
            <items>
                <item>
                    <name>Read local time on Zabbix proxy</name>
                    <type>DEPENDENT</type>
                    <key>proxy.time</key>
                    <delay>0</delay>
                    <trends>0</trends>
                    <units>unixtime</units>
                    <applications>
                        <application>
                            <name>time</name>
                        </application>
                    </applications>
                    <preprocessing>
                        <step>
                            <type>JAVASCRIPT</type>
                            <params>return Math.floor(Date.now() / 1000);</params>
                        </step>
                    </preprocessing>
                    <master_item>
                        <key>zabbix[host,&quot;&quot;,items_unsupported]</key>
                    </master_item>
