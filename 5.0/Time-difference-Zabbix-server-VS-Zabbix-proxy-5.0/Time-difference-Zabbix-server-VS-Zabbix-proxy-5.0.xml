                <item>
                    <name>Read local time on Zabbix server</name>
                    <type>CALCULATED</type>
                    <key>server.time</key>
                    <delay>1s</delay>
                    <trends>0</trends>
                    <units>unixtime</units>
                    <params>0</params>
                    <applications>
                        <application>
                            <name>time</name>
                        </application>
