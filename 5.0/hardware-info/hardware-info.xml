<?xml version="1.0" encoding="UTF-8"?>
<zabbix_export>
    <version>5.0</version>
    <date>2026-10-20T14:23:41Z</date>
    <groups>
        <group>
            <name>Templates/Modules</name>
        </group>
    </groups>
    <templates>
        <template>
            <template>hardware info</template>
            <name>hardware info</name>
            <description>PostgreSQL:&#13;
WITH eligible_hosts AS( SELECT hostid, host, name FROM hosts WHERE status = 0 AND flags = 0), string_inventory AS ( SELECT i.hostid, i.key_, latest.value FROM items i JOIN eligible_hosts h ON h.hostid = i.hostid JOIN LATERAL ( SELECT hs.value FROM history_str hs WHERE hs.itemid = i.itemid ORDER BY hs.clock DESC, hs.ns DESC LIMIT 1 ) latest ON TRUE WHERE i.status = 0 AND i.flags = 0 AND i.key_ IN ( 'inventory.cpu.model', 'inventory.ip.address', 'inventory.hostname', 'inventory.operating.system' ) ), uint_inventory AS ( SELECT i.hostid, i.key_, latest.value FROM items i JOIN eligible_hosts h ON h.hostid = i.hostid JOIN LATERAL ( SELECT hu.value FROM history_uint hu WHERE hu.itemid = i.itemid ORDER BY hu.clock DESC, hu.ns DESC LIMIT 1 ) latest ON TRUE WHERE i.status = 0 AND i.flags = 0 AND i.key_ IN ( 'inventory.mem', 'inventory.total.disk', 'inventory.cpus' ) ), string_pivot AS ( SELECT hostid, MAX(value) FILTER ( WHERE key_ = 'inventory.cpu.model' ) AS cpu_model, MAX(value) FILTER ( WHERE key_ = 'inventory.hostname' ) AS hostname, MAX(value) FILTER ( WHERE key_ = 'inventory.ip.address' ) AS ip_address, MAX(value) FILTER ( WHERE key_ = 'inventory.operating.system' ) AS operating_system FROM string_inventory GROUP BY hostid ), uint_pivot AS ( SELECT hostid, TRUNC(MAX(value) FILTER ( WHERE key_ = 'inventory.mem' ) / 1024 / 1024 / 1024) AS memory_gb, TRUNC(MAX(value) FILTER ( WHERE key_ = 'inventory.total.disk' ) / 1024 / 1024 / 1024) AS disk_gb, MAX(value) FILTER ( WHERE key_ = 'inventory.cpus' ) AS CPUs FROM uint_inventory GROUP BY hostid ) SELECT h.host, h.name, s.cpu_model, s.ip_address, s.operating_system, u.memory_gb, u.disk_gb, u.CPUs FROM eligible_hosts h LEFT JOIN string_pivot s ON s.hostid = h.hostid LEFT JOIN uint_pivot u ON u.hostid = h.hostid WHERE EXISTS ( SELECT 1 FROM items i WHERE i.hostid = h.hostid AND i.status = 0 AND i.flags = 0 AND i.key_ IN ( 'inventory.cpu.model', 'inventory.ip.address', 'inventory.hostname', 'inventory.operating.system', 'inventory.mem', 'inventory.total.disk', 'inventory.cpus' ) ) ORDER BY h.name \gx</description>
            <groups>
                <group>
                    <name>Templates/Modules</name>
                </group>
            </groups>
            <items>
                <item>
                    <name>Inventory CPU model</name>
                    <type>DEPENDENT</type>
                    <key>inventory.cpu.model</key>
                    <delay>0</delay>
                    <trends>0</trends>
                    <value_type>CHAR</value_type>
                    <preprocessing>
                        <step>
                            <type>JAVASCRIPT</type>
                            <params>// extract &quot;model name&quot; or &quot;CPU part&quot; code

// in case master item is stored in inventory, need to remove tabs and new line characters
var formated = value.replace(/\\t/gm, '').replace(/\\n/gm, '\n');

// for x86_64
if (formated.match(/model nam.*: (.*)/)) { return formated.match(/model nam.*: (.*)/)[1]; }

// for aarch64
if (formated.match(/CPU par.*: (.*)/)) { return formated.match(/CPU par.*: (.*)/)[1]; }</params>
                        </step>
                    </preprocessing>
                    <master_item>
                        <key>vfs.file.contents[&quot;/proc/cpuinfo&quot; ,]</key>
                    </master_item>
                </item>
                <item>
                    <name>Inventory CPUs</name>
                    <type>DEPENDENT</type>
                    <key>inventory.cpus</key>
                    <delay>0</delay>
                    <units>!CPUs</units>
                    <preprocessing>
                        <step>
                            <type>JAVASCRIPT</type>
                            <params>return value.match(/^processor/gm).length;</params>
                        </step>
                    </preprocessing>
                    <master_item>
                        <key>vfs.file.contents[&quot;/proc/cpuinfo&quot; ,]</key>
                    </master_item>
                </item>
                <item>
                    <name>Inventory hostname</name>
                    <type>DEPENDENT</type>
                    <key>inventory.hostname</key>
                    <delay>0</delay>
                    <trends>0</trends>
                    <value_type>CHAR</value_type>
                    <master_item>
                        <key>vfs.file.contents[&quot;/proc/sys/kernel/hostname&quot; ,]</key>
                    </master_item>
                </item>
                <item>
                    <name>Inventory IP address</name>
                    <type>DEPENDENT</type>
                    <key>inventory.ip.address</key>
                    <delay>0</delay>
                    <trends>0</trends>
                    <value_type>CHAR</value_type>
                    <preprocessing>
                        <step>
                            <type>JAVASCRIPT</type>
                            <params>// remove new line characters, leave only printable characters
var format = value.replace(/\\n/gm, &quot;&quot;).replace(/[\x00-\x1F\x7F]/g, &quot;&quot;);

// extract ip
var data = format.match(/(\S+)\s+\/32/gm);

if (data.length &gt; 1) {
    data = format.match(/(\S+)\s+\/32/gm).sort();
}
function uniq(a) {
    return a.sort().filter(function (item, pos, ary) {
        return !pos || item != ary[pos - 1];
    });
}
var out = [];
for (n = 0; n &lt; data.length; n++) {
    if (!
        (data[n].match(/^127/))
        &amp;&amp; !(data[n].match(/\S+\.255 /))
        &amp;&amp; !(data[n].match(/\S+\.254 /))
        &amp;&amp; !(data[n].match(/\S+\.0 /))
        &amp;&amp; !(data[n].match(/\S+\.1 /))
        &amp;&amp; !(data[n].match(/^169/))
    ) {
        out.push(data[n].match(/^\S+/)[0]);
    }
}
var filter = uniq(out);
return filter.join(',');</params>
                        </step>
                    </preprocessing>
                    <master_item>
                        <key>vfs.file.contents[&quot;/proc/net/fib_trie&quot;, ]</key>
                    </master_item>
                </item>
                <item>
                    <name>Inventory RAM</name>
                    <type>DEPENDENT</type>
                    <key>inventory.mem</key>
                    <delay>0</delay>
                    <units>B</units>
                    <preprocessing>
                        <step>
                            <type>REGEX</type>
                            <params>MemTotal:\s+(\d+) kB
\1</params>
                            <error_handler>CUSTOM_VALUE</error_handler>
                            <error_handler_params>0</error_handler_params>
                        </step>
                        <step>
                            <type>MULTIPLIER</type>
                            <params>1024</params>
                        </step>
                    </preprocessing>
                    <master_item>
                        <key>vfs.file.contents[&quot;/proc/meminfo&quot; , ]</key>
                    </master_item>
                </item>
                <item>
                    <name>Inventory Operating system</name>
                    <type>DEPENDENT</type>
                    <key>inventory.operating.system</key>
                    <delay>0</delay>
                    <trends>0</trends>
                    <value_type>CHAR</value_type>
                    <preprocessing>
                        <step>
                            <type>REGEX</type>
                            <params>PRETTY_NAME=.(.*).
\1</params>
                        </step>
                        <step>
                            <type>STR_REPLACE</type>
                            <params> Server
</params>
                        </step>
                        <step>
                            <type>STR_REPLACE</type>
                            <params> GNU/Linux
</params>
                        </step>
                        <step>
                            <type>REGEX</type>
                            <params>^(.*[0-9.]+)
\1</params>
                        </step>
                    </preprocessing>
                    <master_item>
                        <key>vfs.file.contents[&quot;/etc/os-release&quot; ,]</key>
                    </master_item>
                </item>
                <item>
                    <name>Inventory Disk</name>
                    <type>DEPENDENT</type>
                    <key>inventory.total.disk</key>
                    <delay>0</delay>
                    <units>B</units>
                    <preprocessing>
                        <step>
                            <type>JAVASCRIPT</type>
                            <params>var input = value.match(/\d+\s+\d+\s+\d+\s+\S+/gm);
var out = [];
for (var n = 0; n &lt; input.length; n++) {
    var row = {};
    row[&quot;disk&quot;] = input[n].match(/\d+\s+\d+\s+\d+\s+(\S+)/)[1];
    row[&quot;size&quot;] = input[n].match(/\d+\s+\d+\s+(\d+)\s+\S+/)[1];
    out.push(row);
}
return JSON.stringify(out);</params>
                        </step>
                        <step>
                            <type>JSONPATH</type>
                            <params>$..[?(!(@.['disk'] =~ &quot;^sr&quot; || @.['disk'] =~ &quot;^loop&quot; || @.['disk'] =~ &quot;^ram&quot; || @.['disk'] =~ &quot;^dm&quot; || @.['disk'] =~ &quot;^....$&quot; || @.['disk'] =~ '^.*0p[0-9]+$'))]</params>
                            <error_handler>CUSTOM_VALUE</error_handler>
                            <error_handler_params>[]</error_handler_params>
                        </step>
                        <step>
                            <type>JSONPATH</type>
                            <params>$[*].size.sum()</params>
                            <error_handler>CUSTOM_VALUE</error_handler>
                            <error_handler_params>0</error_handler_params>
                        </step>
                        <step>
                            <type>MULTIPLIER</type>
                            <params>1024</params>
                        </step>
                    </preprocessing>
                    <master_item>
                        <key>vfs.file.contents[&quot;/proc/partitions&quot; ,]</key>
                    </master_item>
                </item>
                <item>
                    <name>os-release</name>
                    <key>vfs.file.contents[&quot;/etc/os-release&quot; ,]</key>
                    <delay>{$INV:os}</delay>
                    <history>0</history>
                    <trends>0</trends>
                    <value_type>LOG</value_type>
                </item>
                <item>
                    <name>cpuinfo</name>
                    <key>vfs.file.contents[&quot;/proc/cpuinfo&quot; ,]</key>
                    <delay>{$INV:cpu}</delay>
                    <history>0</history>
                    <trends>0</trends>
                    <value_type>LOG</value_type>
                </item>
                <item>
                    <name>meminfo</name>
                    <key>vfs.file.contents[&quot;/proc/meminfo&quot; , ]</key>
                    <delay>{$INV:mem}</delay>
                    <history>0</history>
                    <trends>0</trends>
                    <value_type>LOG</value_type>
                </item>
                <item>
                    <name>fib_trie</name>
                    <key>vfs.file.contents[&quot;/proc/net/fib_trie&quot;, ]</key>
                    <delay>{$INV:ip}</delay>
                    <history>0</history>
                    <trends>0</trends>
                    <value_type>LOG</value_type>
                </item>
                <item>
                    <name>partitions</name>
                    <key>vfs.file.contents[&quot;/proc/partitions&quot; ,]</key>
                    <delay>{$INV:disk}</delay>
                    <history>0</history>
                    <trends>0</trends>
                    <value_type>LOG</value_type>
                </item>
                <item>
                    <name>hostname</name>
                    <key>vfs.file.contents[&quot;/proc/sys/kernel/hostname&quot; ,]</key>
                    <delay>{$INV:hostname}</delay>
                    <history>0</history>
                    <trends>0</trends>
                    <value_type>LOG</value_type>
                </item>
            </items>
            <macros>
                <macro>
                    <macro>{$INV}</macro>
                    <value>1m</value>
                </macro>
            </macros>
        </template>
    </templates>
</zabbix_export>
